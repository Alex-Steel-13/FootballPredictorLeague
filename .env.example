# Copy this file to .env and fill in real values: `cp .env.example .env`
# .env is listed in .gitignore, so it is NEVER pushed to GitHub - that's
# what makes it safe to put real passwords in it.
#
# IMPORTANT: this only covers YOUR LAPTOP. If you deploy this settings.py
# to PythonAnywhere (git pull there), a matching .env with the same values
# must already exist on PythonAnywhere's filesystem too - it has to be
# created manually there (Files tab or a Bash console), since .env never
# travels through git. Do this BEFORE pulling any settings.py change that
# touches these values, or the live site will fail to start.

# Django's secret key. Keep this identical to what's already live on
# PythonAnywhere, or existing sessions/logins there get invalidated.
SECRET_KEY=

# Production MySQL database (PythonAnywhere).
DB_NAME=
DB_USER=
DB_PASSWORD=
# The real database host - e.g. yourusername.mysql.pythonanywhere-services.com
DB_HOST=
DB_PORT=3306

# PythonAnywhere account - used only by scrape_and_upload.py to open its SSH
# tunnel. PA_SSH_PASSWORD is your pythonanywhere.com WEBSITE login password,
# NOT the database password above. Leave it blank to be prompted for it
# each time you run the script instead of storing it here.
PA_USERNAME=
PA_SSH_HOST=ssh.pythonanywhere.com
PA_SSH_PASSWORD=
